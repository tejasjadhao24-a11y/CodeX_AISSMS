# ==============================================================================
# CampusLift Git Ignore Configuration
# ==============================================================================

# Environment files and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.cer
*.crt
*.p12
*.pfx
*.keystore
*.jks

# Google Services / Firebase Credentials
google-services.json
GoogleService-Info.plist

# Python & Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
.pytest_cache/
.coverage
htmlcov/

# Database Files & SQLite Journals
instance/
backend/instance/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Logs and Temporary Files
*.log
*.tmp
*.bak
*.swp
*~

# Flutter & Dart Build Artifacts
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/

# Android Specific
**/android/local.properties
**/android/app/release/
**/android/key.properties
.gradle/
**/android/.gradle/
**/android/captures/

# iOS & macOS Specific
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/ephemeral/
**/ios/Pods/
**/ios/.symlinks/
**/macos/Flutter/ephemeral/
**/macos/Pods/
**/macos/.symlinks/
*.mode1v3
*.mode2v3
*.moved-aside
*.pbxuser
*.perspectivev3

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System & IDE Specific
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
*.iml
*.ipr
*.iws

# User Uploads (Keep directories via .gitkeep)
backend/uploads/avatars/*
!backend/uploads/avatars/.gitkeep
backend/uploads/documents/*
!backend/uploads/documents/.gitkeep