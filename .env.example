# ==============================================================================
# CampusLift .env.example - Environment Variable Template
# Copy this file to .env and replace placeholder values with your credentials.
# NOTE: Never commit your actual .env file with real production secrets!
# ==============================================================================

# Flask Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000

# Application Secrets & Authentication
# Generate strong keys for production (e.g., using python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=campuslift-super-secret-development-key-2024
JWT_SECRET_KEY=campuslift-jwt-signing-secret-development-key-2024

# Database Configuration
# SQLite local instance (default) or PostgreSQL / MySQL URI
DATABASE_URL=sqlite:///campus_lift.db
# DATABASE_URL=postgresql://campus_user:campus_password@localhost:5432/campus_lift_db

# Admin User Bootstrapping
ADMIN_EMAIL=admin@campuslift.edu
ADMIN_PASSWORD=Admin@123

# Flutter Mobile Client Overrides (used with --dart-define during build/run)
# API_URL=http://10.0.2.2:5000/api
# LAN_IP=192.168.1.10
